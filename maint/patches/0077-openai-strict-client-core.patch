+/// Rewrite Grok's extended Chat Completions body into a strict OpenAI shape.
+///
+/// Tool-result images cannot remain on a `role=tool` message for strict
+/// Chat Completions. Keep all consecutive tool messages contiguous and move
+/// their image blocks into one following user multimodal message. This avoids
+/// breaking parallel tool-call ordering while preserving image visibility.
+fn sanitize_strict_chat_body(body: &mut serde_json::Value) {
+    let Some(object) = body.as_object_mut() else {
+        return;
+    };
+
+    if let Some(max_tokens) = object.remove("max_tokens")
+        && !max_tokens.is_null()
+    {
+        object.insert("max_completion_tokens".to_owned(), max_tokens);
+    }
+    object.remove("search_parameters");
+
+    let Some(messages) = object
+        .get_mut("messages")
+        .and_then(serde_json::Value::as_array_mut)
+    else {
+        return;
+    };
+
+    let mut rewritten = Vec::with_capacity(messages.len());
+    let mut pending_images = Vec::new();
+    for mut message in std::mem::take(messages) {
+        let is_tool = message.get("role").and_then(serde_json::Value::as_str) == Some("tool");
+        if !is_tool && !pending_images.is_empty() {
+            rewritten.push(strict_tool_image_message(std::mem::take(&mut pending_images)));
+        }
+
+        if let Some(message_object) = message.as_object_mut() {
+            message_object.remove("model_id");
+            message_object.remove("reasoning_content");
+
+            if is_tool
+                && let Some(blocks) = message_object
+                    .get_mut("content")
+                    .and_then(serde_json::Value::as_array_mut)
+            {
+                let mut text = Vec::new();
+                for block in std::mem::take(blocks) {
+                    match block.get("type").and_then(serde_json::Value::as_str) {
+                        Some("text") => {
+                            if let Some(value) =
+                                block.get("text").and_then(serde_json::Value::as_str)
+                            {
+                                text.push(value.to_owned());
+                            }
+                        }
+                        Some("image_url") => pending_images.push(block),
+                        _ => text.push(block.to_string()),
+                    }
+                }
+                let mut content = text.join("\n");
+                if content.is_empty() && !pending_images.is_empty() {
+                    content = "Tool returned image output.".to_owned();
+                }
+                message_object.insert("content".to_owned(), serde_json::Value::String(content));
+            }
+        }
+        rewritten.push(message);
+    }
+    if !pending_images.is_empty() {
+        rewritten.push(strict_tool_image_message(pending_images));
+    }
+    *messages = rewritten;
+}
+
+fn strict_tool_image_message(images: Vec<serde_json::Value>) -> serde_json::Value {
+    let mut content = vec![serde_json::json!({
+        "type": "text",
+        "text": "Image returned by tool."
+    })];
+    content.extend(images);
+    serde_json::json!({
+        "role": "user",
+        "content": content,
+    })
+}
+
+/// Remove xAI-only Responses extensions while retaining standard OpenAI
+/// fields such as `reasoning.encrypted_content`.
+fn sanitize_strict_response_body(body: &mut serde_json::Value) {
+    let Some(object) = body.as_object_mut() else {
+        return;
+    };
+    object.remove("stream_tool_calls");
+    if let Some(tools) = object
+        .get_mut("tools")
+        .and_then(serde_json::Value::as_array_mut)
+    {
+        tools.retain(|tool| {
+            tool.get("type").and_then(serde_json::Value::as_str) != Some("x_search")
+        });
+    }
+    let mut remove_include = false;
+    if let Some(include) = object
+        .get_mut("include")
+        .and_then(serde_json::Value::as_array_mut)
+    {
+        include.retain(|value| value.as_str() != Some("no_inline_citations"));
+        remove_include = include.is_empty();
+    }
+    if remove_include {
+        object.remove("include");
+    }
+}
+
+fn is_grok_only_header(name: &str) -> bool {
+    let lower = name.to_ascii_lowercase();
+    lower.starts_with("x-grok-")
+        || lower == "x-compactions-remaining"
+        || lower == "x-compaction-at"
+}
