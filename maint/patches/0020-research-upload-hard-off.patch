 3 files changed, 146 insertions(+), 8 deletions(-)

diff --git a/crates/codegen/xai-grok-shell/Cargo.toml b/crates/codegen/xai-grok-shell/Cargo.toml
index 053a6f85f906db0bef92385db8db8e257cd4e96e..f15b0f0767ae1537b332f8ae352f62753f6c6108 100644
