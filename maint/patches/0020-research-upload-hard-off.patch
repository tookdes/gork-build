--- a/crates/codegen/xai-grok-shell/Cargo.toml
+++ b/crates/codegen/xai-grok-shell/Cargo.toml
@@ -37,7 +37,7 @@
 anyhow = { workspace = true }
 xai-grok-announcements = { workspace = true }
 xai-prompt-queue = { workspace = true }
-xai-grok-version = { workspace = true }
+xai-grok-version = { workspace = true, features = ["privacy"] }
 
 async-openai = { workspace = true }
 async-trait = { workspace = true }
