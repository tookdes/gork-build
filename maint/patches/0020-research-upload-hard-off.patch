From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gork CI <gork-ci@users.noreply.github.com>
Date: Fri, 3 Oct 2026 14:50:00 +0800
Subject: [PATCH] research-upload-hard-off: port privacy resolvers to 1.0.45

Keep research/product telemetry and trace upload hard-off in shipped Gork
builds while preserving upstream Distribution-specific helper semantics for
its unit tests. Feedback remains disabled unless the user explicitly opts in
through GROK_FEEDBACK_ENABLED, and whole-repo change packaging defaults off.

Gork-Patch-Id: research-upload-hard-off
Gork-Invariant: research-upload-unreachable
Gork-Risk: critical
---
 crates/codegen/xai-grok-shell/Cargo.toml       |  2 +-
 crates/codegen/xai-grok-shell/src/agent/config.rs | 39 ++++++++++++++++++----
 2 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/crates/codegen/xai-grok-shell/Cargo.toml b/crates/codegen/xai-grok-shell/Cargo.toml
--- a/crates/codegen/xai-grok-shell/Cargo.toml
+++ b/crates/codegen/xai-grok-shell/Cargo.toml
@@ -38,6 +38,6 @@
 xai-grok-announcements = { workspace = true }
 xai-prompt-queue = { workspace = true }
-xai-grok-version = { workspace = true }
+xai-grok-version = { workspace = true, features = ["privacy"] }
 
 async-openai = { workspace = true }
 async-trait = { workspace = true }
diff --git a/crates/codegen/xai-grok-shell/src/agent/config.rs b/crates/codegen/xai-grok-shell/src/agent/config.rs
--- a/crates/codegen/xai-grok-shell/src/agent/config.rs
+++ b/crates/codegen/xai-grok-shell/src/agent/config.rs
@@ -1110,7 +1110,8 @@ impl Default for RepoChangesDedupConfig {
 impl Default for RepoChangesDedupConfig {
     fn default() -> Self {
         Self {
-            enabled: true,
+            // Privacy fork: never package whole-repo changes for research upload.
+            enabled: false,
             include_inline_fallback: false,
             max_inline_bytes: 0,
             dedup_untracked: true,
@@ -1839,8 +1840,20 @@ impl Config {
     pub fn is_trace_upload_enabled(&self) -> bool {
         self.resolve_trace_upload().value
     }
+    /// Privacy builds keep the vendor feedback funnel off unless the user makes
+    /// an explicit local environment opt-in. Config and remote settings cannot
+    /// enable it.
+    pub fn resolve_feedback(&self) -> Resolved<bool> {
+        if xai_grok_version::research_data_collection_forbidden() {
+            if let Some(enabled) = env_bool("GROK_FEEDBACK_ENABLED") {
+                return Resolved::new(enabled, ConfigSource::Env);
+            }
+            return Resolved::new(false, ConfigSource::Default);
+        }
+        self.feature(Feature::Feedback)
+    }
     pub fn is_feedback_enabled(&self) -> bool {
-        self.is_feature_enabled(Feature::Feedback)
+        self.resolve_feedback().value
     }
     pub(crate) fn is_session_recap_enabled(&self) -> bool {
         self.is_feature_enabled(Feature::SessionRecap)
@@ -1855,8 +1868,18 @@ impl Config {
     pub(crate) fn is_two_pass_compaction_enabled(&self) -> bool {
         self.is_feature_enabled(Feature::TwoPassCompaction)
     }
-    pub(crate) fn resolve_telemetry_mode(&self) -> Resolved<TelemetryMode> {
-        if !Distribution::current().allows(Capability::Telemetry) {
+    fn effective_distribution() -> Distribution {
+        if xai_grok_version::research_data_collection_forbidden() {
+            Distribution::withholding(&[Capability::Telemetry])
+        } else {
+            Distribution::current()
+        }
+    }
+    pub fn resolve_telemetry_mode(&self) -> Resolved<TelemetryMode> {
+        self.resolve_telemetry_mode_as(Self::effective_distribution())
+    }
+    fn resolve_telemetry_mode_as(&self, distribution: Distribution) -> Resolved<TelemetryMode> {
+        if !distribution.allows(Capability::Telemetry) {
             return Resolved::new(TelemetryMode::Disabled, ConfigSource::Default);
         }
         if let Some(mode) = self.requirements.telemetry.pinned() {
@@ -1884,12 +1908,12 @@ impl Config {
         }
         Resolved::new(TelemetryMode::Disabled, ConfigSource::Default)
     }
-    pub(crate) fn resolve_trace_upload(&self) -> Resolved<bool> {
-        self.resolve_trace_upload_as(Distribution::current())
+    pub fn resolve_trace_upload(&self) -> Resolved<bool> {
+        self.resolve_trace_upload_as(Self::effective_distribution())
     }
     fn resolve_trace_upload_as(&self, distribution: Distribution) -> Resolved<bool> {
         if !distribution.allows(Capability::Telemetry) {
             return Resolved::new(false, ConfigSource::Default);
         }
-        let mode = self.resolve_telemetry_mode();
+        let mode = self.resolve_telemetry_mode_as(distribution);
         let ff = if mode.value.is_disabled() {
