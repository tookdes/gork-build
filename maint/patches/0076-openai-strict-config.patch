 use xai_grok_sampling_types::{
     CompactionAtTokens, CompactionsRemaining, REASONING_EFFORT_META_KEY,
     REASONING_EFFORTS_META_KEY, ReasoningEffort, ReasoningEffortOption,
@@ -1112,6 +1114,7 @@ pub struct ConfigModelOverride {
     pub temperature: Option<f32>,
     pub top_p: Option<f32>,
     pub api_backend: Option<ApiBackend>,
+    pub openai_compat: Option<OpenAiCompat>,
     #[serde(default)]
     pub extra_headers: IndexMap<String, String>,
     #[serde(default)]
@@ -1177,6 +1180,22 @@ impl ConfigModelOverride {
         if !self.extra_headers.is_empty() {
             entry.info.extra_headers = self.extra_headers.clone();
         }
+        // Carry the model-level compatibility policy through the existing
+        // catalog -> ModelInfo -> SamplerConfig pipeline without widening all
+        // of those public structs. SamplingClient consumes this reserved key
+        // before HTTP header validation, so it can never reach the wire.
+        if let Some(mode) = self.openai_compat {
+            entry
+                .info
+                .extra_headers
+                .shift_remove(OPENAI_COMPAT_MARKER);
+            if mode == OpenAiCompat::Strict {
+                entry.info.extra_headers.insert(
+                    OPENAI_COMPAT_MARKER.to_owned(),
+                    "strict".to_owned(),
+                );
+            }
+        }
         if !self.query_params.is_empty() {
             entry.info.query_params = self.query_params.clone();
         }

