+/// Compatibility policy for OpenAI-shaped backends.
+///
+/// `Native` preserves Grok/xAI wire extensions. `Strict` asks the sampler to
+/// emit only the provider-neutral OpenAI request shape for Chat Completions or
+/// Responses endpoints.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum OpenAiCompat {
+    #[default]
+    Native,
+    Strict,
+}
+
+/// Reserved model-catalog metadata used to carry `openai_compat` through the
+/// existing model-resolution pipeline. It is deliberately not a valid HTTP
+/// header name and is consumed by `SamplingClient::new` before header parsing.
+pub const OPENAI_COMPAT_MARKER: &str = "@grok/openai-compat";
+
 /// All knobs that control a single sampling request.
 ///
 /// The session typically owns one `SamplerConfig` per active model
diff --git a/crates/codegen/xai-grok-sampler/src/lib.rs b/crates/codegen/xai-grok-sampler/src/lib.rs
