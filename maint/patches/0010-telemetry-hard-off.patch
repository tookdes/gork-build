diff --git a/crates/codegen/xai-grok-otel/src/provider.rs b/crates/codegen/xai-grok-otel/src/provider.rs
index b2e1ba29b35b72dcf7dff2a2a85ca5207670289a..66c474508cd709e7172bd43a4359aba319610908 100644
--- a/crates/codegen/xai-grok-otel/src/provider.rs
+++ b/crates/codegen/xai-grok-otel/src/provider.rs
@@ -70,6 +70,11 @@ fn build_tracer_provider(
     mode: OtelProviderMode,
     session_metrics_gate: SessionMetricsGate,
 ) -> SdkTracerProvider {
+    // Gork privacy build: vendor OTLP tracing is never constructed, even if
+    // CLI/settings request Server mode or enable the exporter.
+    if xai_grok_version::research_data_collection_forbidden() {
+        return SdkTracerProvider::builder().build();
+    }
     match mode {
         OtelProviderMode::Server => build_server_provider(client, config, session_metrics_gate),
         OtelProviderMode::Local => SdkTracerProvider::builder().build(),
@@ -357,3 +362,61 @@ pub fn shutdown_provider() {
         started.elapsed().as_millis()
     );
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::config::OtelExporterConfig;
+    use xai_grok_auth::{CredentialSnapshot, HttpAuth};
+
+    struct ForbiddenCredentials;
+
+    impl HttpAuth for ForbiddenCredentials {
+        fn apply(&self, _: reqwest::RequestBuilder, _: &str) -> reqwest::RequestBuilder {
+            panic!("privacy provider must not authorize an exporter request");
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl AuthCredentialProvider for ForbiddenCredentials {
+        fn snapshot(&self) -> CredentialSnapshot {
+            panic!("privacy provider must return before reading exporter credentials");
+        }
+
+        async fn refresh_after_unauthorized(&self) -> bool {
+            panic!("privacy provider must not refresh exporter credentials");
+        }
+    }
+
+    #[test]
+    fn server_exporter_is_never_constructed_under_privacy() {
+        assert!(xai_grok_version::research_data_collection_forbidden());
+        // Server mode must stay local even when settings explicitly enable OTLP.
+        // build_server_provider reads a snapshot first, so losing the privacy
+        // chokepoint fails here before any network client can be constructed.
+        for enabled in [false, true] {
+            let provider = build_tracer_provider(
+                OtelClientInfo {
+                    client_name: "privacy-test",
+                    client_version: "test",
+                    service_version: "test",
+                    app_entrypoint: "test",
+                },
+                OtelLayerConfig {
+                    credentials: Arc::new(ForbiddenCredentials),
+                    token_header_value: "test".into(),
+                    alpha_test_key: None,
+                    exporter: OtelExporterConfig {
+                        enabled,
+                        traces_url: "https://otel.example.invalid/v1/traces".into(),
+                        ..Default::default()
+                    },
+                },
+                OtelProviderMode::Server,
+                Arc::new(|| true),
+            );
+            provider.force_flush().unwrap();
+            provider.shutdown().unwrap();
+        }
+    }
+}
