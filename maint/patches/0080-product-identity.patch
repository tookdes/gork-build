From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gork CI <gork-ci@users.noreply.github.com>
Date: Mon, 31 Aug 2026 03:30:00 +0000
Subject: [PATCH] product-identity: ship the gork CLI surface

Gork-Patch-Id: product-identity
Gork-Invariant: product-cli-gork
Gork-Risk: medium
---
 crates/codegen/xai-grok-pager-bin/Cargo.toml | 6 +++---
 crates/codegen/xai-grok-pager/src/app/cli.rs | 4 ++--
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/crates/codegen/xai-grok-pager-bin/Cargo.toml b/crates/codegen/xai-grok-pager-bin/Cargo.toml
index 8858b8bcaa6d13cf0db8e5ed4be2bae2e39073b2..391ec1b2f8843ffbb79180aa9190134c22c59921 100644
--- a/crates/codegen/xai-grok-pager-bin/Cargo.toml
+++ b/crates/codegen/xai-grok-pager-bin/Cargo.toml
@@ -3,8 +3,8 @@ name = "xai-grok-pager-bin"
 version = "1.0.24"
 edition.workspace = true
 license = "Apache-2.0"
-authors = ["xAI"]
-default-run = "xai-grok-pager"
+authors = ["Gork Build contributors"]
+default-run = "gork"
 
 # Composition-root binary for the Grok Build TUI. The artifact is still named
 # `xai-grok-pager`. This package exists so the binary can link both the pager
@@ -12,7 +12,7 @@ default-run = "xai-grok-pager"
 # depends on `xai-grok-pager`, so the pager library cannot depend back on it
 # (cargo cycle). The binary installs the minimal-mode IoC hooks at startup.
 [[bin]]
-name = "xai-grok-pager"
+name = "gork"
 path = "src/main.rs"
 
 [dependencies]
diff --git a/crates/codegen/xai-grok-pager/src/app/cli.rs b/crates/codegen/xai-grok-pager/src/app/cli.rs
index 87f63aef9443ec272ef9a37dfd774b6114d08d8f..bf1b6b2b39868e9e5d03b9ff8947c49a73f089d9 100644
--- a/crates/codegen/xai-grok-pager/src/app/cli.rs
+++ b/crates/codegen/xai-grok-pager/src/app/cli.rs
@@ -394,9 +394,9 @@ pub struct LeaderArgs {
 }
 #[derive(Debug, Clone, Parser)]
 #[command(
-    name = "grok",
+    name = "gork",
     version = xai_grok_version::full_version(),
-    about = "Grok Build TUI",
+    about = "Gork Build TUI",
     disable_version_flag = true,
     next_display_order = None,
     help_template = "\

