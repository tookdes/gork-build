From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gork CI <gork-ci@users.noreply.github.com>
Date: Fri, 3 Oct 2026 11:30:00 +0800
Subject: [PATCH] vendor-updater-hard-off: port install chokepoints to 1.0.45

Gork product builds never query, download, or install vendor updates. Keep a
feature-gated loopback escape hatch only for installer integration tests.

Gork-Patch-Id: vendor-updater-hard-off
Gork-Invariant: vendor-install-unreachable
Gork-Risk: critical
---

diff --git a/crates/codegen/xai-grok-update/Cargo.toml b/crates/codegen/xai-grok-update/Cargo.toml
--- a/crates/codegen/xai-grok-update/Cargo.toml
+++ b/crates/codegen/xai-grok-update/Cargo.toml
@@ -25,7 +25,7 @@
 xai-grok-shell = { path = "../xai-grok-shell", default-features = false }
 xai-grok-telemetry = { workspace = true }
 xai-grok-tools = { workspace = true }
-xai-grok-version = { workspace = true }
+xai-grok-version = { workspace = true, features = ["privacy"] }
 flate2 = { workspace = true }
 zstd = { workspace = true }
 sha2 = { workspace = true }
@@ -37,9 +37,12 @@
 [target.'cfg(target_os = "macos")'.dependencies]
 libc = { workspace = true }
 
-[features]
-default = ["xai-grok-shell/default"]
-default-bazel = []
+[features]
+default = ["xai-grok-shell/default"]
+default-bazel = []
+# Test-only escape hatch for loopback installer integration suites.
+# Product builds never enable this feature.
+updater-integration-tests = []
 
 [dev-dependencies]
 semver = { workspace = true }
diff --git a/crates/codegen/xai-grok-update/src/auto_update.rs b/crates/codegen/xai-grok-update/src/auto_update.rs
--- a/crates/codegen/xai-grok-update/src/auto_update.rs
+++ b/crates/codegen/xai-grok-update/src/auto_update.rs
@@ -31,7 +31,32 @@
 
 const PROMPT_UPDATE_NOW: &str = "Update now? [Y/n/d]";
 const MSG_AUTO_UPDATE_BACKGROUND: &str = "Auto-update running in background.";
-const MSG_RUN_UPDATE_MANUAL: &str = "Run `grok update` to get the latest version.";
+const MSG_RUN_UPDATE_MANUAL: &str = "Run `grok update` to get the latest version.";
+/// Test-only env escape hatch. Ignored unless updater integration tests are
+/// explicitly compiled with the matching feature.
+#[doc(hidden)]
+pub const TEST_ALLOW_UPDATE_ENV: &str = "GORK_TEST_ALLOW_UPDATE";
+
+/// Gork Build never installs binaries from xAI/vendor update channels.
+#[inline]
+pub fn vendor_auto_update_forbidden() -> bool {
+    #[cfg(feature = "updater-integration-tests")]
+    {
+        if std::env::var(TEST_ALLOW_UPDATE_ENV).as_deref() == Ok("1") {
+            return false;
+        }
+    }
+    xai_grok_version::PRIVACY_BUILD || xai_grok_version::research_data_collection_forbidden()
+}
+
+pub fn vendor_update_blocked_message() -> String {
+    "Gork Build never installs from vendor update channels. Rebuild from source or install a Gork Build release from https://github.com/tookdes/gork-build/releases."
+        .to_string()
+}
+
+fn vendor_update_blocked_err() -> anyhow::Error {
+    anyhow::anyhow!("{}", vendor_update_blocked_message())
+}
 
 /// Manual-install one-liner for this platform's bootstrap installer. On Unix the variable must prefix `bash` (which runs
 /// install.sh), not `curl`. In `VAR=x curl … | bash` the assignment applies to `curl` only and install.sh would fall back
@@ -225,8 +250,19 @@
     Ok(())
 }
 
-pub async fn check_update_status(update_config: &UpdateConfig) -> UpdateStatus {
-    let installer = get_installer().await.map(|value| value.to_string());
+pub async fn check_update_status(update_config: &UpdateConfig) -> UpdateStatus {
+    if vendor_auto_update_forbidden() {
+        return UpdateStatus {
+            current_version: get_installed_grok_version(),
+            latest_version: None,
+            update_available: false,
+            installer: None,
+            channel: update_config.channel.clone(),
+            auto_update: Some(false),
+            error: None,
+        };
+    }
+    let installer = get_installer().await.map(|value| value.to_string());
     let current_version = get_installed_grok_version();
     let current_config = config::load_config().await;
     let auto_update = current_config.cli.auto_update;
@@ -378,8 +414,11 @@
 /// Installer and version the leader/background path should converge to: an upgrade OR an authoritative-installer rollback.
 /// `None` means stay put.
 /// Gates on the installer (via `installer_allows_downgrade`) so npm is never downgraded; the decision depends on the installer, never the caller.
-pub async fn auto_update_target(update_config: &UpdateConfig) -> Option<(&'static str, String)> {
-    let installer = get_installer().await?;
+pub async fn auto_update_target(update_config: &UpdateConfig) -> Option<(&'static str, String)> {
+    if vendor_auto_update_forbidden() {
+        return None;
+    }
+    let installer = get_installer().await?;
     if installer == WINGET {
         return None;
     }
@@ -414,8 +453,14 @@
 /// Unlike [`run_update`] this never uses the compiled-in version for the download decision. A binary already installed by
 /// another process (TUI background download, explicit `grok update`) is reused as-is. On Windows a busy leader therefore
 /// still re-downloads hourly; only the symlink layout can prove the disk is current without exec'ing the binary.
-pub async fn ensure_latest_on_disk(update_config: &UpdateConfig) -> Result<EnsureLatestOutcome> {
-    let _ensure_span = xai_grok_telemetry::region!(
+pub async fn ensure_latest_on_disk(update_config: &UpdateConfig) -> Result<EnsureLatestOutcome> {
+    if vendor_auto_update_forbidden() {
+        return Ok(EnsureLatestOutcome {
+            installed: None,
+            relaunch_needed: false,
+        });
+    }
+    let _ensure_span = xai_grok_telemetry::region!(
         "update.ensure_latest",
         xai_grok_telemetry::region::Parent::Inherit
     );
@@ -624,8 +669,11 @@
 /// Check for available updates without blocking the TUI startup. Sets [`BackgroundUpdateCheck::update`] when the running
 /// binary is older than the channel pointer. If `auto_update` is enabled and the on-disk install is also behind the
 /// pointer, kicks off a download (a detached `grok update` child). Only the restart hint is shown.
-pub async fn check_update_background(update_config: &UpdateConfig) -> BackgroundUpdateCheck {
-    let Some(installer) = get_installer().await else {
+pub async fn check_update_background(update_config: &UpdateConfig) -> BackgroundUpdateCheck {
+    if vendor_auto_update_forbidden() {
+        return BackgroundUpdateCheck::none();
+    }
+    let Some(installer) = get_installer().await else {
         return BackgroundUpdateCheck::none();
     };
     if installer == WINGET {
@@ -713,12 +761,15 @@
     interactive: bool,
     trigger: CliUpdateTrigger,
     update_config: &UpdateConfig,
-) -> Result<bool> {
-    let Some(inst) = get_installer().await else {
-        return Ok(false);
-    };
-
-    heal_managed_install(inst).await;
+) -> Result<bool> {
+    if vendor_auto_update_forbidden() {
+        return Ok(false);
+    }
+    let Some(inst) = get_installer().await else {
+        return Ok(false);
+    };
+
+    heal_managed_install(inst).await;
 
     if is_version_cache_fresh().await {
         return Ok(false);
@@ -962,8 +1013,11 @@
     target: Option<&str>,
     update_config: &UpdateConfig,
     trigger: CliUpdateTrigger,
-) -> Result<()> {
-    // What's on disk is being replaced, not this (possibly stale) process's version; npm has no trustworthy disk version, so it falls back
+) -> Result<()> {
+    if vendor_auto_update_forbidden() {
+        return Err(vendor_update_blocked_err());
+    }
+    // What's on disk is being replaced, not this (possibly stale) process's version; npm has no trustworthy disk version, so it falls back
     let from_version =
         disk_version_for_installer(installer).unwrap_or_else(get_installed_grok_version);
     let started = Instant::now();
@@ -1451,8 +1505,11 @@
 }
 
 /// Returns the version that was actually activated.
-async fn install_internal(target: Option<&str>, update_config: &UpdateConfig) -> Result<String> {
-    let bases = crate::version::cli_base_urls();
+async fn install_internal(target: Option<&str>, update_config: &UpdateConfig) -> Result<String> {
+    if vendor_auto_update_forbidden() {
+        return Err(vendor_update_blocked_err());
+    }
+    let bases = crate::version::cli_base_urls();
     let base_refs: Vec<&str> = bases.iter().map(String::as_str).collect();
     install_internal_from_bases(target, update_config, &base_refs).await
 }
@@ -2564,9 +2621,12 @@
     channel_switch: Option<&str>,
     update_config: &mut UpdateConfig,
     trigger: CliUpdateTrigger,
-) -> Result<Option<String>> {
-    let installer = get_installer().await;
-    let policy = config::VersionPolicy::resolve();
+) -> Result<Option<String>> {
+    if vendor_auto_update_forbidden() {
+        return Err(vendor_update_blocked_err());
+    }
+    let installer = get_installer().await;
+    let policy = config::VersionPolicy::resolve();
     if let Some(version) = pinned_version
         && let Err(e) = crate::version_policy::check_install_target(&policy, version)
     {
@@ -2804,8 +2864,84 @@
     }
 }
 
-#[path = "windows_payload.rs"]
-mod windows_payload;
+
+#[cfg(test)]
+mod privacy_tests {
+    use super::*;
+
+    fn privacy_update_config() -> UpdateConfig {
+        UpdateConfig {
+            proxy_base_url: "http://127.0.0.1:9/v1".to_string(),
+            auth_scope: "privacy-test".to_string(),
+            deployment_key: None,
+            alpha_test_key: None,
+            channel: "stable".to_string(),
+            npm_registry: None,
+        }
+    }
+
+    #[test]
+    fn privacy_build_forbids_vendor_auto_update() {
+        assert!(xai_grok_version::PRIVACY_BUILD);
+        assert!(vendor_auto_update_forbidden());
+        assert!(vendor_update_blocked_message().contains("never installs from vendor"));
+        assert!(vendor_update_blocked_message().contains("tookdes/gork-build"));
+    }
+
+    #[test]
+    fn privacy_env_cannot_disable_vendor_auto_update() {
+        unsafe { std::env::set_var(TEST_ALLOW_UPDATE_ENV, "1") };
+        assert!(
+            vendor_auto_update_forbidden(),
+            "env alone must not bypass the production privacy hard-off"
+        );
+        unsafe { std::env::remove_var(TEST_ALLOW_UPDATE_ENV) };
+    }
+
+    #[tokio::test]
+    async fn run_install_script_fail_closed_under_privacy() {
+        let cfg = privacy_update_config();
+        let err = run_install_script(
+            "internal",
+            Some("1.0.0"),
+            &cfg,
+            CliUpdateTrigger::UserCommand,
+        )
+        .await
+        .expect_err("privacy build must reject installer execution");
+        assert!(format!("{err:#}").contains("never installs from vendor"));
+    }
+
+    #[tokio::test]
+    async fn ensure_latest_on_disk_no_install_under_privacy() {
+        let out = ensure_latest_on_disk(&privacy_update_config()).await.unwrap();
+        assert!(out.installed.is_none());
+        assert!(!out.relaunch_needed);
+    }
+
+    #[tokio::test]
+    async fn auto_update_target_none_under_privacy() {
+        assert!(auto_update_target(&privacy_update_config()).await.is_none());
+    }
+
+    #[tokio::test]
+    async fn explicit_run_update_refuses_under_privacy() {
+        let mut cfg = privacy_update_config();
+        let err = run_update(
+            false,
+            None,
+            None,
+            &mut cfg,
+            CliUpdateTrigger::UserCommand,
+        )
+        .await
+        .expect_err("explicit update must be blocked before any vendor request");
+        assert!(format!("{err:#}").contains("never installs from vendor"));
+    }
+}
+
+#[path = "windows_payload.rs"]
+mod windows_payload;
 
 #[cfg(test)]
 #[path = "auto_update_tests.rs"]

