From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tooktang <tooktang@gmail.com>
Date: Sat, 12 Sep 2026 13:58:10 +0800
Subject: [PATCH] consent-record-hard-off: keep consent acknowledgements local

Upstream records consent acceptance through the ACP x.ai/consent/record method. Gork Build keeps the local acknowledgement so the UI does not re-prompt, but never emits or sends the upstream record.

Gork-Patch-Id: consent-record-hard-off

Gork-Invariant: consent-ack-stays-local

Gork-Risk: critical
---
 .../xai-grok-pager/src/app/dispatch/session/lifecycle.rs  | 4 +++-
 crates/codegen/xai-grok-pager/src/app/effects/mod.rs      | 8 ++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs b/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs
index 36734450b731b1509eb8f4d683672666ee1e280f..97aca268797864c43afd601fb43683aa538f2cb8 100644
--- a/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs
+++ b/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs
@@ -666,7 +666,9 @@ pub(in crate::app::dispatch) fn dispatch_accept_consent(app: &mut AppView) -> Ve
             acked: false,
         });
     }
-    effects.push(Effect::RecordConsentUpstream { notice_id, version });
+    if !xai_grok_version::PRIVACY_BUILD {
+        effects.push(Effect::RecordConsentUpstream { notice_id, version });
+    }
     effects.extend(finish_consent(app));
     effects
 }
diff --git a/crates/codegen/xai-grok-pager/src/app/effects/mod.rs b/crates/codegen/xai-grok-pager/src/app/effects/mod.rs
index d50435d09e40d865755de41677fa4a172c462b50..594c1aa4fd02fd68871949014e309c67735189b3 100644
--- a/crates/codegen/xai-grok-pager/src/app/effects/mod.rs
+++ b/crates/codegen/xai-grok-pager/src/app/effects/mod.rs
@@ -2176,6 +2176,14 @@ pub(crate) fn execute(
                 });
         }
         Effect::RecordConsentUpstream { notice_id, version } => {
+            if xai_grok_version::PRIVACY_BUILD {
+                tracing::info!(
+                    %notice_id,
+                    version,
+                    "privacy build: consent acknowledgement stays local"
+                );
+                return (false, meta);
+            }
             let tx = acp_tx.clone();
             tasks
                 .spawn(async move {

