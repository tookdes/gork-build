+) {
+    if let Some(agent) = agent {
+        match resolve_agent_arg(agent) {
+            ResolvedAgent::FilePath(path) => config.agent_profile_path = Some(path),
+            ResolvedAgent::Name(name) => config.agent.name = Some(name),
