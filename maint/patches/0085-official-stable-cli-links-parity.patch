+pub fn parse_json_schema(input: &str) -> anyhow::Result<serde_json::Value> {
+    let schema: serde_json::Value = serde_json::from_str(input)
+        .map_err(|e| anyhow::anyhow!("--json-schema: invalid JSON: {e}"))?;
+    if !schema.is_object() {
+        anyhow::bail!("--json-schema: must be a JSON object describing a JSON Schema");
+    }
+    Ok(schema)
+}
+
+/// Resolve `-p/--single`: join explicit words, or read stdin when the flag is bare.
+pub fn resolve_single_prompt(single: Option<&[String]>) -> anyhow::Result<Option<String>> {
+    let stdin = std::io::stdin();
+    let mut stdin = stdin.lock();
+    resolve_single_prompt_with_reader(single, &mut stdin)
+}
+
+fn resolve_single_prompt_with_reader<R: std::io::Read>(
+    single: Option<&[String]>,
+    reader: &mut R,
+) -> anyhow::Result<Option<String>> {
+    let Some(words) = single else {
+        return Ok(None);
+    };
+    if !words.is_empty() {
+        return Ok(Some(words.join(" ")));
+    }
+
+    let mut prompt = String::new();
+    reader
+        .read_to_string(&mut prompt)
+        .map_err(|e| anyhow::anyhow!("--single: failed to read stdin: {e}"))?;
+    Ok(Some(prompt))
+}
 
