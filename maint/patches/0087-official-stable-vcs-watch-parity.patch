+                match debouncer.watch(&path, mode) {
+                    Ok(()) => armed.vcs += 1,
+                    Err(e) => tracing::warn!("failed to watch git path {path:?}: {e:?}"),
+                }
+            }
+            tracing::debug!("fs_notify: watching git dir {git_dir:?}");
+        }
