-    if let (Ok(p), Ok(c)) = (dunce::canonicalize(path), dunce::canonicalize(cwd))
-        && let Ok(rel) = p.strip_prefix(&c)
-    {
-        return has_hidden(rel);
-    }
-    false
-}
