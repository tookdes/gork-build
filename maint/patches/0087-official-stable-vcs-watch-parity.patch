+    /// A VCS-only source watches git metadata but not workspace directories.
+    #[test]
+    #[serial]
+    fn vcs_only_ignores_workspace_tree_and_keeps_head_events() {
+        let temp = TempDir::new().unwrap();
+        let root = dunce::canonicalize(temp.path()).unwrap();
+        fs::create_dir_all(root.join(".git/refs/heads")).unwrap();
+        fs::write(root.join(".git/HEAD"), "ref: refs/heads/main\n").unwrap();
+        fs::write(root.join(".git/refs/heads/main"), "abc123\n").unwrap();
+        for i in 0..20 {
+            fs::create_dir_all(root.join(format!("src/deep/{i}"))).unwrap();
+        }
+
+        let (mut rx, handle) = start_vcs_only_with_timeout(
+            root.clone(),
+            FsNotifyConfig {
+                debounce_ms: TEST_DEBOUNCE_MS,
+                ignore_patterns: vec![],
+            },
+            true,
+            WatchStrategy::PerDir,
+            TEST_INIT_TIMEOUT,
+        )
+        .unwrap();
+
+        assert_eq!(
+            handle.watch_count(),
+            3,
+            "VCS-only mode should arm only .git, refs, and refs/heads"
+        );
+
+        fs::write(root.join("src/deep/0/workspace.txt"), "ignored").unwrap();
+        let workspace_events = collect_events(&mut rx);
+        assert!(
+            workspace_events.is_empty(),
+            "workspace writes must not reach a VCS-only watcher: {workspace_events:?}"
+        );
+
+        fs::write(root.join(".git/HEAD"), "ref: refs/heads/other\n").unwrap();
+        let git_events = collect_events_smart(
+            &mut rx,
+            Duration::from_millis(EVENT_WAIT_MS * 2),
+            Duration::from_millis(50),
+        );
+        assert!(
+            git_events
+                .iter()
+                .any(|event| event.paths.iter().any(|path| path.ends_with(".git/HEAD"))),
+            "HEAD writes must still reach the VCS-only watcher: {git_events:?}"
+        );
+    }
