+/// Get a shared source that watches only governing VCS metadata. This is safe
+/// for current-branch / HEAD tracking but must not serve workspace-file consumers.
+#[tracing::instrument(name = "fsnotify.vcs_only_watcher_install", skip_all)]
+pub fn shared_vcs_only(
+    cwd: PathBuf,
+    config: FsConfig,
+) -> Result<Arc<FsEventSource>, FsNotifyError> {
+    let key = canonical_key(&cwd);
+
+    {
+        let mut map = vcs_only_registry()
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        map.retain(|_, w| w.strong_count() > 0);
+        if let Some(existing) = map.get(&key).and_then(Weak::upgrade) {
+            drop(map);
+            let live_watchers = stats().live_watchers;
+            record_reuse(&key, live_watchers);
+            return Ok(existing);
+        }
+    }
+
+    let handle = event_loop_handle()?;
+    let source = Arc::new(FsEventSource::start_on_vcs_only(handle, cwd, config)?);
+
+    let mut map = vcs_only_registry()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner);
+    if let Some(existing) = map.get(&key).and_then(Weak::upgrade) {
+        drop(map);
+        let live_watchers = stats().live_watchers;
+        record_reuse(&key, live_watchers);
+        return Ok(existing);
+    }
+    map.insert(key.clone(), Arc::downgrade(&source));
+    drop(map);
+    let live_watchers = stats().live_watchers;
+    record_create(&key, live_watchers);
+    Ok(source)
+}
