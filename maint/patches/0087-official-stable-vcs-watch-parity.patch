+                    tracing::warn!(
+                        "fs_notify: {} non-ignored dirs exceed watch budget {budget}; shedding \
+                         the deepest (raise with GROK_FSNOTIFY_MAX_WATCHES)",
+                        dirs.len()
+                    );
+                    dirs.truncate(budget);
+                }
