+/// Snapshot shared-watcher stats. Prunes dead registry entries first.
+/// `reused_total` should grow with session count while `live_watchers` stays
+/// bounded by active full-workspace / VCS-only source configurations.
+pub fn stats() -> FsWatcherStats {
+    let live = {
+        let mut map = registry().lock().unwrap_or_else(PoisonError::into_inner);
+        map.retain(|_, w| w.strong_count() > 0);
+        let full = map.len();
+        drop(map);
+
+        let mut map = vcs_only_registry()
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        map.retain(|_, w| w.strong_count() > 0);
+        full + map.len()
+    };
