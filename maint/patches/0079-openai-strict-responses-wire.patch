+    fn strict_config(api_backend: ApiBackend) -> SamplerConfig {
+        let mut config = minimal_config();
+        config.api_backend = api_backend;
+        config
+            .extra_headers
+            .insert(OPENAI_COMPAT_MARKER.to_owned(), "strict".to_owned());
+        config
+    }
+
+    #[test]
+    fn strict_chat_body_uses_openai_fields_and_rehomes_tool_images() {
+        let mut body = serde_json::json!({
+            "model": "gpt-test",
+            "max_tokens": 123,
+            "search_parameters": {"mode": "auto"},
+            "messages": [
+                {
+                    "role": "assistant",
+                    "content": "thinking done",
+                    "model_id": "grok-internal",
+                    "reasoning_content": "private reasoning",
+                    "tool_calls": [{"id": "a", "type": "function", "function": {"name": "view", "arguments": "{}"}}]
+                },
+                {
+                    "role": "tool",
+                    "tool_call_id": "a",
+                    "content": [
+                        {"type": "text", "text": "first"},
+                        {"type": "image_url", "image_url": {"url": "data:image/png;base64,AAA"}}
+                    ]
+                },
+                {
+                    "role": "tool",
+                    "tool_call_id": "b",
+                    "content": [
+                        {"type": "image_url", "image_url": {"url": "data:image/png;base64,BBB"}}
+                    ]
+                },
+                {"role": "assistant", "content": "continue"}
+            ]
+        });
+        sanitize_strict_chat_body(&mut body);
+        assert!(body.get("max_tokens").is_none());
+        assert_eq!(body["max_completion_tokens"], serde_json::json!(123));
+        assert!(body.get("search_parameters").is_none());
+        let messages = body["messages"].as_array().unwrap();
+        assert!(messages.iter().all(|message| message.get("model_id").is_none()));
+        assert!(
+            messages
+                .iter()
+                .all(|message| message.get("reasoning_content").is_none())
+        );
+        assert_eq!(messages[1]["role"], "tool");
+        assert_eq!(messages[1]["content"], "first");
+        assert_eq!(messages[2]["role"], "tool");
+        assert_eq!(messages[2]["content"], "Tool returned image output.");
+        assert_eq!(messages[3]["role"], "user");
+        assert_eq!(messages[3]["content"].as_array().unwrap().len(), 3);
+        assert_eq!(messages[4]["role"], "assistant");
+    }
+
+    #[test]
+    fn strict_response_body_removes_only_xai_extensions() {
+        let mut body = serde_json::json!({
+            "stream_tool_calls": true,
+            "include": ["reasoning.encrypted_content", "no_inline_citations"],
+            "tools": [
+                {"type": "web_search"},
+                {"type": "x_search"},
+                {"type": "function", "name": "f"}
+            ]
+        });
+        sanitize_strict_response_body(&mut body);
+        assert!(body.get("stream_tool_calls").is_none());
+        assert_eq!(
+            body["include"],
+            serde_json::json!(["reasoning.encrypted_content"])
+        );
+        assert_eq!(body["tools"].as_array().unwrap().len(), 2);
+        assert!(
+            body["tools"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .all(|tool| tool["type"] != "x_search")
+        );
+    }
+
+    #[test]
+    fn strict_client_suppresses_x_grok_headers_and_marker() {
+        let mut config = strict_config(ApiBackend::ChatCompletions);
+        config.client_version = Some("1.2.3".to_owned());
+        config.deployment_id = Some("dep".to_owned());
+        config.user_id = Some("user".to_owned());
+        config
+            .extra_headers
+            .insert("x-grok-custom".to_owned(), "blocked".to_owned());
+        config
+            .extra_headers
+            .insert("x-compaction-at".to_owned(), "1000".to_owned());
+        let client = SamplingClient::new(config).expect("strict client should construct");
+        assert!(client.defaults.strict_openai);
+        assert!(
+            client
+                .default_headers
+                .keys()
+                .all(|name| !is_grok_only_header(name.as_str()))
+        );
+    }
+
+    #[test]
+    fn strict_messages_backend_is_rejected_early() {
+        let err = SamplingClient::new(strict_config(ApiBackend::Messages)).unwrap_err();
+        assert!(matches!(err, SamplingError::InvalidConfiguration(_)));
+        assert!(err.to_string().contains("Anthropic Messages API"));
+    }
+
