--- a/crates/codegen/xai-grok-shell/src/agent/config_tests.rs
+++ b/crates/codegen/xai-grok-shell/src/agent/config_tests.rs
@@ -1170,6 +1170,36 @@ fn parses_model_api_key() {
     assert_eq!(model.info.base_url, "https://api.example.com/v1");
