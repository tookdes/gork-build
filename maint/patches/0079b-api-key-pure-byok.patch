     }
+    // A pinned API-key process is pure BYOK. A session stores the routing slug,
+    // so a later key-first lookup must not reinterpret it as a built-in row.
+    if matches!(
+        cfg.grok_com_config.preferred_method,
+        Some(xai_grok_login::PreferredAuthMethod::ApiKey)
+    ) {
+        resolved.retain(|key, _| cfg.config_models.contains_key(key));
+        tracing::info!(
+            model_count = resolved.len(),
+            "preferred_method=api_key: using explicit [model.*] catalog only"
+        );
+    }
     for (key, entry) in resolved.iter_mut() {
         if let Some(ref mut provider) = entry.auth_provider {
             if provider.is_fail_closed() {
