 }
 #[test]
+fn api_key_pin_uses_explicit_catalog_and_preserves_slug_alias() {
+    let raw_config: toml::Value = toml::from_str(
+        r#"
+            [auth]
+            preferred_method = "api_key"
+
+            [model.grok]
+            model = "grok-4.6"
+            base_url = "https://gateway.example/v1"
+            context_window = 200000
+            api_key = "sk-test"
+            api_backend = "responses"
+            "#,
+    )
+    .unwrap();
+    let cfg = Config::new_from_toml_cfg(&raw_config).expect("config should parse");
+    let resolved = resolve_model_list(&cfg, None);
+
+    assert!(resolved.contains_key("grok"));
+    assert!(
+        !resolved.contains_key("grok-4.6"),
+        "pinned API-key mode must not retain the colliding built-in catalog id"
+    );
+    let model = find_model_by_id(&resolved, "grok-4.6")
+        .expect("routing slug should resolve to the explicit alias entry");
+    assert_eq!(model.info.model, "grok-4.6");
+    assert_eq!(model.info.base_url, "https://gateway.example/v1");
+    assert_eq!(model.api_key.as_deref(), Some("sk-test"));
+}
