From: Gork CI <gork-ci@users.noreply.github.com>
Date: Mon, 31 Aug 2026 10:00:00 -0700
Subject: [PATCH] openai-strict-chat-wire: sanitize Chat Completions requests

Gork-Patch-Id: openai-strict-chat-wire
Gork-Invariant: strict-openai-chat-wire
Gork-Risk: critical
---

diff --git a/crates/codegen/xai-grok-sampler/src/client.rs b/crates/codegen/xai-grok-sampler/src/client.rs
--- a/crates/codegen/xai-grok-sampler/src/client.rs
+++ b/crates/codegen/xai-grok-sampler/src/client.rs
@@ -958,7 +1092,14 @@ impl SamplingClient {
             builder,
             sent_bearer,
         } = self.post(self.endpoint("chat/completions"));
-        let http_request = grok_headers.apply(builder).json(&payload);
+        let builder = self.apply_grok_headers(grok_headers, builder);
+        let http_request = if self.defaults.strict_openai {
+            let mut body = serde_json::to_value(&payload).map_err(SamplingError::Serialization)?;
+            sanitize_strict_chat_body(&mut body);
+            builder.json(&body)
+        } else {
+            builder.json(&payload)
+        };
 
         let response = http_request.send().await.map_err(|e| {
             // Log at debug level; errors are surfaced to the caller.
@@ -1021,10 +1162,17 @@ impl SamplingClient {
             builder,
             sent_bearer,
         } = self.post(self.endpoint("chat/completions"));
-        let http_request = grok_headers
-            .apply(builder)
-            .header(ACCEPT, HeaderValue::from_static("text/event-stream"))
-            .json(&streaming_request);
+        let builder = self
+            .apply_grok_headers(grok_headers, builder)
+            .header(ACCEPT, HeaderValue::from_static("text/event-stream"));
+        let http_request = if self.defaults.strict_openai {
+            let mut body =
+                serde_json::to_value(&streaming_request).map_err(SamplingError::Serialization)?;
+            sanitize_strict_chat_body(&mut body);
+            builder.json(&body)
+        } else {
+            builder.json(&streaming_request)
+        };
 
         let built_request = http_request.build().map_err(|e| {
             tracing::error!("Failed to build HTTP request: {}", e);

